%define _unpackaged_files_terminate_build 1
%define _stripped_files_terminate_build 1
%set_verify_elf_method strict

Name: solc
Version: 0.8.37
# Keep in sync with Version when updating the package.
%define commit f401782d
Release: alt1

Summary: Solidity compiler for Ethereum smart contracts
Summary(ru_RU.UTF-8): Компилятор Solidity для смарт-контрактов Ethereum
License: GPL-3.0-or-later
Group: Development/Other
Url: https://soliditylang.org/
Vcs: https://github.com/argotorg/solidity.git
ExclusiveArch: x86_64 aarch64

Source: %name-%version.tar

Provides: solidity = %EVR

BuildRequires(pre): rpm-macros-cmake
BuildRequires: rpm-build-cmake gcc-c++
BuildRequires: boost-asio-devel boost-devel boost-filesystem-devel
BuildRequires: boost-program_options-devel
BuildRequires: libfmt-devel nlohmann-json-devel librange-v3-devel

%description
solc is the command-line compiler for Solidity, a statically typed,
contract-oriented language for implementing smart contracts on the Ethereum
Virtual Machine.

%description -l ru_RU.UTF-8
solc — компилятор командной строки для Solidity, статически типизированного
контрактно-ориентированного языка программирования смарт-контрактов для
виртуальной машины Ethereum.

%prep
%setup
# These files reproduce the release metadata generated by upstream's
# create_source_tarball.sh for v0.8.37.
printf '%s\n' %commit > commit_hash.txt
: > prerelease.txt

%build
%cmake \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DBoost_USE_STATIC_LIBS=OFF \
    -DIGNORE_VENDORED_DEPENDENCIES=ON \
    -DPROPERTY_BASED_TESTS=OFF \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
%cmake_build

%install
%cmake_install
rm %buildroot%_bindir/yul-phaser

%check
SOLIDITY_BUILD_DIR=%_target_platform \
    ./scripts/soltest.sh --no-smt --no-semantic-tests

%files
%doc LICENSE.txt README.md
%_bindir/solc

%changelog
* Thu Oct 08 2026 Georgij Tsarin <crystarm@altlinux.org> 0.8.37-alt1
- Initial build for ALT Sisyphus.
