%define _unpackaged_files_terminate_build 1

# Use shellcheck only on these architectures
%ifarch x86_64 aarch64
%def_enable check
%else
%def_disable check
%endif

Name: system-restore
Version: 0.83
Release: alt1

Summary: ALT System Restore and Deployment
Group: Archiving/Backup
License: GPLv3+

BuildArch: noarch

Url: https://github.com/klark973/system-restore
Source: %name-%version.tar
AutoReq: noshell, noshebang

Requires: bash
Requires: btrfs-progs
Requires: coreutils
Requires: curl
Requires: dialog
Requires: dosfstools
Requires: e2fsprogs
Requires: filesystem
Requires: gawk
Requires: grep
Requires: iproute2
Requires: lsblk
Requires: lvm2
Requires: mdadm
Requires: pigz
Requires: pv
Requires: sed
Requires: sfdisk
Requires: tar
Requires: udev
Requires: util-linux

# Having NVRAM platforms
%ifarch x86_64 aarch64 ppc64le
Requires: efibootmgr
%endif

Requires: bash-builtin-lockf >= 0.3

%{!?_disable_check:BuildRequires: bash shellcheck}

Packager: Leonid Krivoshein <klark@altlinux.org>

%description
A solution for deployment and recovery. It allows
to install the system very quickly and completely
automatically from a pre-prepared rootfs backup.

%define _progcfg %_sysconfdir/%name
%define _progdir /usr/libexec/%name

%prep
%setup -q
%autopatch -p1

%build
cat >workdir/sys-part/sysrest/version.sh <<EOF
# SPDX-License-Identifier: GPL-3.0-or-later

# Auto-generated by the build system, do not edit directly!
#
SYSREST_VERSION=%version
SYSREST_BUILD_DATE=$(date '+%%Y%%m%%d')

EOF

%install
mkdir -p -m 0755 %buildroot{%_progcfg,%_bindir,/usr/libexec,%_logdir}
mv -f workdir/sys-part/{%name,system-profile} %buildroot%_bindir/
mv -f workdir/sys-part/sysrest %buildroot%_progdir
:> %buildroot%_progcfg/restore.conf
:> %buildroot%_progcfg/profile.conf
:> %buildroot%_logdir/%name.log

%check
/bin/bash -efu ./check-scripts.sh "%buildroot"

%files
%dir %_progcfg
%ghost %config(noreplace) %_progcfg/restore.conf
%ghost %config(noreplace) %_progcfg/profile.conf
%ghost %_logdir/%name.log
%_bindir/system-profile
%_bindir/%name
%_progdir
%doc AUTHORS LICENSE README.md TODO.md CHANGELOG.md doc iso results workdir

%changelog
