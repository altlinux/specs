%define target_lua_version 5.4

# Original package name http
%define oname http
%define oversion 0.4-0
%define rockspec http-0.4-0.rockspec
Name: lua%target_lua_version-module-%oname
Version: 0.4
Release: alt2_lr0
Summary: HTTP library for Lua
License: MIT
Group: Development/Other
Url: https://github.com/daurnimator/lua-http

# These Obsoletes/Provides only necessary when previous (out-of-poicy) versions exist in repo
%if "%target_lua_version" == "5.4"
Obsoletes: lua-module-%oname < %EVR
Provides: lua-module-%oname = %version
%else
Obsoletes: lua5-%oname < %EVR
Provides: lua5-%oname = %version
%endif

Source: https://github.com/daurnimator/lua-http/archive/v0.4.tar.gz#/lua-http-0.4.tar.gz
Source1: https://luarocks.org/manifests/luarocks/http-0.4-0.rockspec

BuildPreReq: rpm-macros-lua >= 1.5.2 rpm-build-lua
BuildRequires: luarocks%target_lua_version(cqueues) >= 20161214 luarocks%target_lua_version(luaossl) >= 20161208 luarocks%target_lua_version(basexx) >= 0.2.0 luarocks%target_lua_version(lpeg) luarocks%target_lua_version(lpeg_patterns) >= 0.5 luarocks%target_lua_version(binaryheap) >= 0.3 luarocks%target_lua_version(fifo) 
BuildRequires: luarocks5.1(cqueues) >= 20161214 luarocks5.1(luaossl) >= 20161208 luarocks5.1(basexx) >= 0.2.0 luarocks5.1(lpeg) luarocks5.1(lpeg_patterns) >= 0.5 luarocks5.1(binaryheap) >= 0.3 luarocks5.1(fifo) 
BuildRequires: luarocks5.1(compat53) luarocks5.1(bit32)
# Automatically added by buildreq on ...
BuildRequires: lua%target_lua_version-luarocks lua5.1-luarocks

BuildArch: noarch
#BuildRequires: lua5.3-luarocks

%description
lua-http is an performant, capable HTTP and WebSocket library for Lua.

%if 0
%package -n lua5.3-module-%oname
Summary: HTTP library for Lua
Group: Development/Other
%description -n lua5.3-module-%oname
lua-http is an performant, capable HTTP and WebSocket library for Lua.
%endif
%package -n lua5.1-module-%oname
Summary: HTTP library for Lua
Group: Development/Other
%description -n lua5.1-module-%oname
lua-http is an performant, capable HTTP and WebSocket library for Lua.

%prep
%setup -n lua-%oname-%version

%install
%luarocks_make %SOURCE1
%luarocks_move_docs doc

%check
%lua_path_add_buildroot
[ -x /usr/bin/busted ] || exit 0
busted

%add_findreq_skiplist %luarocks_dbdir_prefix-*/%oname/*/{doc,docs,etc,examples,samples,spec,test}/*
%filter_from_requires /lua5.4(compat53.module)/d

%files
%lua54_modulesdir_noarch/*
%luarocks_dbdir_prefix-%target_lua_version/%oname
%doc CONTRIBUTING* LICENSE* NEWS examples spec docs_from_rockstree/*
%exclude %luarocks_dbdir_prefix-%target_lua_version/manifest

%if 0
%files -n lua5.3-module-%oname
%lua53_modulesdir_noarch/*
%luarocks_dbdir_prefix-5.3/%oname
%doc CONTRIBUTING* LICENSE* NEWS examples spec docs_from_rockstree/*
%exclude %luarocks_dbdir_prefix-5.3/manifest
%endif

%files -n lua5.1-module-%oname
%lua51_modulesdir_noarch/*
%luarocks_dbdir_prefix-5.1/%oname
%doc CONTRIBUTING* LICENSE* NEWS examples spec docs_from_rockstree/*
%exclude %luarocks_dbdir_prefix-5.1/manifest

