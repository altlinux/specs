Name: pi-hole-web
Version: 6.5.1
Release: alt1

Summary: Pi-hole Dashboard for stats and more
License: EUPL-1.2
Group: Networking/WWW
Url: https://github.com/pi-hole/web
BuildArch: noarch
# https://github.com/pi-hole/web/archive/refs/tags/v%%version.tar.gz
Source: %name-%version.tar.gz

%description
Pi-hole Web interface (based off of AdminLTE) provides a central location
to manage your Pi-hole and review the statistics generated by FTLDNS.

%prep
%setup

%install
install -dm755 %buildroot/var/www/html/admin

cp -dpr --no-preserve=ownership * %buildroot/var/www/html/admin

rm %buildroot/var/www/html/admin/*.md
rm %buildroot/var/www/html/admin/LICENSE
rm %buildroot/var/www/html/admin/package*.json

%files
%doc LICENSE
/var/www/html/admin/

