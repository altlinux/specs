%define _unpackaged_files_terminate_build 1

# MeshAgent ARCHID values are upstream platform identifiers.
# Build only agents native to the current ALT architecture.
%ifarch x86_64
%define meshagent_archid 6
%define meshagent_filename meshagent_x86-64
%define meshagent_nokvm_archid 20
%define meshagent_nokvm_filename meshagent_x86-64_nokvm
%endif

%ifarch %ix86
%define meshagent_archid 5
%define meshagent_filename meshagent_x86
%define meshagent_nokvm_archid 19
%define meshagent_nokvm_filename meshagent_x86_nokvm
%endif

%ifarch aarch64
%define meshagent_archid 32
%define meshagent_filename meshagent_aarch64
%endif

%ifarch armh
%define meshagent_archid 25
%define meshagent_filename meshagent_armhf
%endif

%define mc_user  meshcentral
%define mc_group meshcentral
%define mc_migration_dir %_localstatedir/meshcentral-migration

Name:    meshcentral
Version: 1.2.5
Release: alt3

Summary: A complete web-based remote monitoring and management web site
License: Apache-2.0
Group:   Networking/Remote access
Url:   	 https://meshcentral.com/
Vcs:     https://github.com/Ylianst/MeshCentral.git

Source: %name-%version.tar
# Generated by .gear/generate-node-modules.sh
Source1: node_modules.tar
Source2: %name.service
# Pinned MeshAgent source used to build native agent binaries.
Source3: meshagent.tar
Source4: README.ALT
Source5: meshcentral-migrate-state.sh

# MeshCentral packaging integration.
Patch1: meshcentral-1.2.5-alt-fix-module-lookup.patch
Patch2: meshcentral-1.2.5-alt-disable-runtime-npm-installation.patch

# MeshAgent build integration and upstream fixes.
Patch3: meshagent-20260215-alt-openssl3-compat.patch
Patch4: meshagent-20260215-alt-rpm-build-flags.patch
Patch5: meshagent-20260215-alt-source-metadata.patch
Patch6: meshagent-20260216-upstream-linux-compile-fix.patch
Patch7: meshagent-20260602-upstream-fix-validate-mesh-server-signature.patch
Patch8: meshagent-20260917-alt-backport-fix-stack-allocation-size.patch
Patch9: meshagent-20260215-alt-use-system-zlib.patch
# Restore extra backup folders to their configured destinations (PR #8098).
Patch10: meshcentral-1.2.5-alt-fix-backup-restore-paths.patch
# Allow the service to use a writable global recordings directory.
Patch11: meshcentral-1.2.5-alt-fix-recordings-path.patch

BuildRequires(pre): rpm-macros-nodejs
BuildRequires: libssl-devel
BuildRequires: libjpeg-devel
BuildRequires: libX11-devel
BuildRequires: libXtst-devel
BuildRequires: libXext-devel
BuildRequires: xorg-proto-devel
BuildRequires: zlib-devel

# agents/ contains client-side payloads and installer scripts served to
# managed hosts; their dependencies are not server runtime requirements.
%add_findreq_skiplist %nodejs_sitelib/%name/agents/*

%description
MeshCentral is a full computer management web site. With MeshCentral,
you can run your own web server to remotely manage and control computers
on a local network or anywhere on the internet. Once you get the server started,
create device group and download and install an agent on each computer you want
to manage. A minute later, the new computer will show up on the web site
and you can take control of it. MeshCentral includes full web-based
remote desktop, terminal and file management capability.
The ALT package provides MeshAgent binaries built from source for the
native architecture. Administrators can provide agents for additional
platforms via /var/lib/meshcentral/meshcentral-data/agents/. See README.ALT for
details.

%prep
%setup -a 1 -a 3

cp -p %SOURCE4 README.ALT
cp -p %SOURCE5 meshcentral-migrate-state.sh

# Remove upstream prebuilt MeshAgent binaries. Native agents for the
# current architecture are built from Source3 below.
rm -f \
    agents/meshagent_* \
    agents/MeshService*.exe \
    agents/MeshAgentOSXPackager.zip \
    agents/hashagents.json

%patch1 -p1
%patch2 -p1
%patch10 -p1
%patch11 -p1

pushd meshagent
%patch3 -p1
%patch4 -p1
%patch5 -p1
%patch6 -p1
%patch7 -p1
%patch8 -p1
%patch9 -p1
popd

%build
%ifarch %ix86 x86_64 aarch64 armh
pushd meshagent
# Build the native Linux MeshAgent against system OpenSSL and libjpeg.
# Leave stripping and debug symbol handling to RPM.

make -j1 clean
make -j1 linux \
    ARCHID=%meshagent_archid \
    DYNAMICTLS=1 \
    NOTURBOJPEG=1 \
    STRIP=: \
    SYMBOLCP=: \
    PACKAGING_CFLAGS="%optflags"

%ifarch %ix86 x86_64
# Also provide the upstream variant without KVM support.
make -j1 clean
make -j1 linux \
    ARCHID=%meshagent_nokvm_archid \
    DYNAMICTLS=1 \
    NOTURBOJPEG=1 \
    STRIP=: \
    SYMBOLCP=: \
    PACKAGING_CFLAGS="%optflags"
%endif

popd
%endif

%install
install -d %buildroot%nodejs_sitelib/meshcentral
cp -a \
  *.js package.json sample-config*.json meshcentral-config-schema.json \
  amt agents emails public rdp translate views node_modules \
  %buildroot%nodejs_sitelib/meshcentral/

# Install MeshAgent binaries built from the pinned source tree.
%ifarch %ix86 x86_64 aarch64 armh
install -pm0644 meshagent/%meshagent_filename \
    %buildroot%nodejs_sitelib/%name/agents/%meshagent_filename

%ifarch %ix86 x86_64
install -pm0644 meshagent/%meshagent_nokvm_filename \
    %buildroot%nodejs_sitelib/%name/agents/%meshagent_nokvm_filename
%endif
%endif

# Mark the installation as system-managed to prevent self-updates
# and runtime npm installation.
install -Dm0644 /dev/null \
    %buildroot%nodejs_sitelib/%name/daemon

sed -i 's|require("../meshcentral.js");|require("../meshcentral.js").mainStart();|' bin/meshcentral

install -Dm0755 bin/%name %buildroot%nodejs_sitelib/%name/bin/%name

install -d %buildroot%_bindir
ln -sr \
    %buildroot%nodejs_sitelib/%name/bin/%name \
    %buildroot%_bindir/%name

# Keep configuration in the data directory so it is included in backups.
# Provide the conventional /etc entry point through an absolute symlink.
install -d %buildroot%_localstatedir/%name
install -d %buildroot%_localstatedir/%name/meshcentral-data
install -d %buildroot%_localstatedir/%name/meshcentral-files
install -d %buildroot%_localstatedir/%name/meshcentral-backups
install -d %buildroot%_localstatedir/%name/meshcentral-recordings

install -Dm0640 sample-config-advanced.json \
    %buildroot%_localstatedir/%name/meshcentral-data/config.json

sed -i \
    -e 's/"_autoBackup"[[:space:]]*:/"autoBackup":/' \
    -e 's#"_backupPath"[[:space:]]*:[[:space:]]*"[^"]*"#"backupPath": "%_localstatedir/%name/meshcentral-backups"#' \
    %buildroot%_localstatedir/%name/meshcentral-data/config.json

install -d %buildroot%_sysconfdir/%name
ln -s %_localstatedir/%name/meshcentral-data/config.json \
    %buildroot%_sysconfdir/%name/config.json

install -Dp -m0644 %SOURCE2 %buildroot%_unitdir/%name.service

%pre -f meshcentral-migrate-state.sh
set -e
umask 077
getent group %mc_group >/dev/null || groupadd -r %mc_group
getent passwd %mc_user >/dev/null || \
    useradd -r -g %mc_group -s /sbin/nologin \
    -d %_localstatedir/%name -c "MeshCentral service user" %mc_user
meshcentral_migration_phase=pre

%post -f %name-migrate-state.sh
set -e
umask 077
# Reload the guarded unit before any migration operation can fail.
# ALT defers the actual restart until the transaction has finished.
%post_service_posttrans_restart %name
meshcentral_migration_phase=post

%preun
%preun_service %name

%files
%doc *.md LICENSE README.ALT
%_bindir/%name
%nodejs_sitelib/%name
%_unitdir/%name.service
%dir %_sysconfdir/%name
%_sysconfdir/%name/config.json

%attr(0750,%mc_user,%mc_group) %dir %_localstatedir/%name
%attr(0750,%mc_user,%mc_group) %dir %_localstatedir/%name/meshcentral-data
%attr(0750,%mc_user,%mc_group) %dir %_localstatedir/%name/meshcentral-files
%attr(0750,%mc_user,%mc_group) %dir %_localstatedir/%name/meshcentral-backups
%attr(0750,%mc_user,%mc_group) %dir %_localstatedir/%name/meshcentral-recordings

%attr(0640,%mc_user,%mc_group) %config(noreplace) %_localstatedir/%name/meshcentral-data/config.json

