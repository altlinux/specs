%define _unpackaged_files_terminate_build 1

Name: maki
Version: 0.7.1
Release: alt1
Summary: AI coding agent with native Rust TUI
License: MIT
Group: Development/Tools
Url: https://maki.sh
Vcs: https://github.com/tontinton/maki.git

Source: %name-%version.tar
Source1: %name-predownloaded-%version.tar
Patch1: %name-%version-%release.patch

ExcludeArch: %ix86 %arm
BuildRequires(pre): rpm-macros-rust
BuildRequires: rpm-build-rust
# TLS is rustls since 0.7.0 (reqwest selects the aws-lc-rs crypto provider):
# aws-lc-sys builds its C library with cmake, ring and the tree-sitter
# grammars with cc. libcurl and OpenSSL are gone from the dependency graph, so
# nothing links against them any more.
BuildRequires: gcc-c++
BuildRequires: cmake

# rustls-platform-verifier (and tonic's tls-roots for OTLP) load trust anchors
# from the system store, /etc/ssl/certs; nothing ships a bundled CA set.
Requires: ca-certificates

%description
Maki is an AI coding agent with a native Rust TUI: immediate startup,
60 FPS, low memory.

%prep
%setup -a1
%patch1 -p1
%rust_prep
# Redirect the git dependencies (crossterm, syntect) to the vendored sources;
# %%rust_prep only handles crates-io. Generated by the .gear/up.d hook.
cat vendor-config.toml >> .cargo/config.toml

%build
%rust_build -p maki --bin maki

%install
%rust_install maki

%files
%doc README.md LICENSE
%_bindir/maki

