%define _unpackaged_files_terminate_build 1

Name: maki
Version: 0.6.4
Release: alt1
Summary: AI coding agent with native Rust TUI
License: MIT
Group: Development/Tools
Url: https://maki.sh
Vcs: https://github.com/tontinton/maki.git

Source: %name-%version.tar
Source1: %name-predownloaded-%version.tar
Patch1: %name-%version-%release.patch

ExcludeArch: %ix86 %arm
BuildRequires(pre): rpm-macros-rust
BuildRequires: rpm-build-rust
# isahc links the system libcurl (OpenSSL backend) dynamically instead of
# the vendored static-curl+rustls build; openssl-sys headers for the
# declared native-tls backend.
BuildRequires: gcc-c++
BuildRequires: pkgconfig(libcurl)
BuildRequires: pkgconfig(openssl)
# libz-sys (pulled by curl-sys) prefers the system zlib when present.
BuildRequires: pkgconfig(zlib)

Requires: ca-certificates

%description
Maki is an AI coding agent with a native Rust TUI: immediate startup,
60 FPS, low memory.

%prep
%setup -a1
%patch1 -p1
%rust_prep
# Redirect the git dependencies (crossterm, monty, syntect) to the vendored
# sources; %%rust_prep only handles crates-io. Generated by the merge.up hook.
cat vendor-config.toml >> .cargo/config.toml

%build
%rust_build -p maki --bin maki

%install
%rust_install maki

%files
%doc README.md LICENSE
%_bindir/maki

%changelog
* Tue Oct 20 2026 Alexey Shabalin <shaba@altlinux.org> 0.6.4-alt1
- Initial build for Sisyphus.
