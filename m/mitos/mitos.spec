%global _unpackaged_files_terminate_build 1
%def_with check

Name: mitos
Version: 0.2.1
Release: alt1
Summary: Mitos is a fast and minimal modal text editor
License: MPL-2.0
Group: Editors
URL: https://mitos.computer
VCS: https://github.com/mitos-editor/mitos

ExcludeArch: %ix86

Source: %name-%version.tar
Source1: vendor.tar
Source2: grammars.tar

BuildRequires(pre): rpm-macros-rust
BuildRequires: rpm-build-rust
BuildRequires: gcc-c++

%if_with check
BuildRequires: git-core
BuildRequires: /dev/pts
%endif

%description
Mitos is a modern, batteries-included, modal text editor written in Rust.
It is a fork of Helix and continues its selection-first editing model with
multi-select, built-in language server support, and tree-sitter-powered
syntax awareness.

%package grammars
Summary: Tree-sitter grammars supported by %name
Group: Development/Other
Requires: %name >= %EVR

%description grammars
%summary.

%prep
%setup -a1 -a2
# %%rust_prep is not used: it handles only the crates.io replacement,
# while this package has a Git dependency (filesentry). The complete
# source replacement config generated by cargo-vendor-alt is supplied
# via --config vendor/config.toml at build and test time.
rm -rf runtime/grammars
mv grammars runtime/

%build
export MITOS_DEFAULT_RUNTIME=%_datadir/%name/runtime
export CARGO_PROFILE_RELEASE_STRIP=false
%rust_build -p term --locked --config vendor/config.toml
cargo run --release --locked --offline --config vendor/config.toml \
    --package grammar-build --bin grammar-build

%install
%rust_install ms
rm -rf runtime/grammars/sources
rm -f runtime/grammars/.sources-revisions
mkdir -p %buildroot%_libdir/%name
cp -a runtime/grammars %buildroot%_libdir/%name/

mkdir -p %buildroot%_datadir/%name
cp -a runtime %buildroot%_datadir/%name/runtime
rm -rf %buildroot%_datadir/%name/runtime/grammars
ln -s ../../../%_lib/%name/grammars %buildroot%_datadir/%name/runtime/grammars

install -Dpm 644 contrib/completion/ms.bash %buildroot%_datadir/bash-completion/completions/ms
install -Dpm 644 contrib/completion/ms.fish %buildroot%_datadir/fish/vendor_completions.d/ms.fish
install -Dpm 644 contrib/completion/ms.zsh %buildroot%_datadir/zsh/site-functions/_ms

%check
export MITOS_DEFAULT_RUNTIME=%_datadir/%name/runtime
export CARGO_PROFILE_RELEASE_STRIP=false
%rust_test -p term --locked --config vendor/config.toml

%files
%_bindir/ms
%dir %_datadir/%name
%dir %_libdir/%name
%dir %_libdir/%name/grammars
%_datadir/%name/runtime
%_datadir/bash-completion/completions/ms
%_datadir/fish/vendor_completions.d/ms.fish
%_datadir/zsh/site-functions/_ms
%doc LICENSE README.md CHANGELOG.md

%files grammars
%_libdir/%name/grammars/*.so

