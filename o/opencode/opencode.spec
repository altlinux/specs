# bun build --compile appends its payload past everything the ELF headers
# describe; eu-strip rewrites the file and drops the payload, and the result
# aborts at startup. So there is no debuginfo package and rpm must not strip.
%global __strip /bin/true

# Node's names for the platform, not RPM's: the build target is derived from
# them and the dist directory is named after them.
%ifarch x86_64
%global node_arch x64
%endif
%ifarch aarch64
%global node_arch arm64
%endif

# The build produces one bun-compiled CLI, shared by /usr/bin and the desktop
# client (which resolves it through a symlink, see Patch5). OPENCODE_TARGET
# pins upstream's build script to that one target: the plain flavour for the
# architecture, under the name the desktop patch expects.
%ifarch x86_64
%global cli_target linux-x64
%global cli_dist cli-linux-x64
%endif
%ifarch aarch64
%global cli_target linux-arm64
%global cli_dist cli-linux-arm64
%endif

# ALT rpm does not define the AppStream metainfo directory.
%global _metainfodir %_datadir/metainfo

Name: opencode
Version: 2.2.4
Release: alt1

# bun build --compile output carries no DWARF and breaks under eu-strip (see
# %%__strip at the top), so the binary is deliberately without debuginfo: keep
# find-debuginfo off it (this also silences the brp "stripped ELF" warning).
%add_debuginfo_skiplist %_bindir/%name
# The desktop app directory embeds a prebuilt Node-API pty module; there is no
# debuginfo for it either, and find-debuginfo must not walk the directory.
%add_debuginfo_skiplist %_libexecdir/%name-desktop

Summary: AI coding agent for the terminal
License: MIT
Group: Development/Other
Url: https://%name.ai
Vcs: https://github.com/anomalyco/%name
Packager: Nazarov Denis <nenderus@altlinux.org>

# https://github.com/anomalyco/%name/archive/v%version/%name-%version.tar.gz
Source: %name-%version.tar
# The npm dependency tree, committed unpacked. Both the CLI (bun build
# --compile) and the desktop client (electron-vite) need it on disk and it
# cannot be built from a plain release tarball; see opencode_vendor.
Source1: %name-vendor-%version.tar
# The tree-sitter grammars the highlighter would otherwise download at run
# time, and the patch that points the parser table at them.
Source2: %name-tree-sitter-%version.tar
Source3: %{name}_grammars
Source4: %{name}_vendor
# Upstream's build script fails unless bun satisfies a caret range around the
# version it pins. The range is satisfied by the distribution bun, so the patch
# is inert today; kept because both versions float and a major bump on either
# side would otherwise stop the build over upstream's convenience.
Patch0: %name-relax-bun-version.patch
# Stop the binary fetching and executing code over the network at run time.
# Each patch header says what it stops and which environment variable restores
# upstream behaviour.
Patch1: %name-no-self-update.patch
Patch2: %name-no-runtime-npm-install.patch
# Point the highlighter's parser table at the vendored grammars instead of
# GitHub URLs (generated by opencode_grammars).
Patch3: %name-local-grammars.patch
# Desktop client: resolve the window icon, the bundled CLI executable and its
# version sidecar against the app directory instead of process.resourcesPath,
# which the system electron points into its own distribution when handed an
# app directory.
Patch4: %name-desktop-local-resources.patch
# Desktop client: ship a symlink to the packaged CLI instead of embedding a
# second copy of the ~200 MB binary into the app directory.
Patch5: %name-desktop-symlinked-cli.patch
# Desktop client: the update UI built on electron-updater cannot work without
# the feed file electron-builder would install, and must not install upstream
# releases over a packaged build anyway; gate it like the CLI guard.
Patch6: %name-desktop-no-updater.patch
# Desktop client: bundle the production dependencies the main entry reaches
# at run time into the main chunk - the app directory is assembled without a
# node_modules tree.
Patch7: %name-desktop-bundle-runtime-deps.patch

BuildRequires: bun
# Bun's shell resolves its own executable through /proc; without this the
# hasher build root gets a stub /proc and that fails.
BuildRequires: /proc
# The desktop build feeds the source tree into a git index so the Tailwind
# scanner sees every file (see the comment in the %%build section).
BuildRequires: git-core
# Upstream supports x86_64 and aarch64 only.
ExclusiveArch: x86_64 aarch64
# The tree-sitter grammars (Patch3) are read by the TUI of this very binary,
# and the server shells out to these tools.
Requires: ripgrep
Requires: git-core
# Former noarch data subpackage: the grammars serve the terminal client
# alone, and the desktop client requires this package anyway, so the split
# had no second consumer. Take over the installed instances on upgrade.
Provides: %name-common = %EVR
Obsoletes: %name-common < %EVR

%description
%name is an AI coding agent that runs in the terminal. It works with a
range of model providers, reads and edits files in a project, runs commands,
and keeps a session history.

This package is the command line client; the desktop client is packaged
separately as %name-desktop. It does not update itself, install npm packages
into your home directory, or download syntax highlighting grammars from
GitHub.

%package desktop
Summary: Desktop client for %name, the AI coding agent
Group: Development/Other
# The app directory carries a symlink to the CLI executable (Patch5), and the
# server it talks to is that same binary: the desktop client is built from the
# same sources and must not run against a mismatched one.
Requires: %name = %EVR
# The app runs on the distribution electron. Upstream develops against 44.x;
# the code is written against the stable Electron API surface and the only
# native module it embeds is ABI-agnostic (Node-API). Verified against the
# distribution electron.
Requires: electron >= 42

%description desktop
%name-desktop is the Electron desktop client of %name. The opencode server
is the packaged %name binary, which the client resolves and stages on first
run; it ships the syntax highlighting grammars and shells out to ripgrep
and git itself.

The client does not update itself: updates arrive with the package.

%prep
# Source1 (the committed dependency tree: node_modules and the per-workspace
# symlink farms) and Source2 (the vendored grammars) are laid over the source.
%setup -a 1 -a 2
%patch0 -p1
%patch1 -p1
%patch2 -p1
%patch3 -p1
%patch4 -p1
%patch5 -p1
%patch6 -p1
%patch7 -p1

# This bunfig only configures `bun test`/dev preloads, which the build does
# not run.
%__rm -f packages/cli/bunfig.toml

%build
export HOME="$PWD/.home"
export BUN_INSTALL_CACHE_DIR="$PWD/.bun-cache"
export TMPDIR="$PWD/.tmp"
%__mkdir_p "$HOME" "$BUN_INSTALL_CACHE_DIR" "$TMPDIR"
# The version has to be explicit: upstream derives release builds' versions
# from its release workflow. "latest" is the release channel; the build
# script refuses a latest-channel build without a version.
export OPENCODE_VERSION="%version"
export OPENCODE_CHANNEL=latest

cd packages/cli
# OPENCODE_TARGET builds exactly one target: the plain flavour for the
# architecture. For that target bun embeds the running bun itself as the
# runtime and fetches nothing - and the distribution bun on x86_64 is an
# x86-64-v2 (baseline) build, so the single binary the package ships runs on
# any CPU. --skip-install uses the committed dependency tree; --skip-web-ui
# leaves out the browser interface.
OPENCODE_TARGET=%cli_target bun ./script/build.ts --skip-install --skip-web-ui
cd ../..

#
# Desktop client.
#

# The Tailwind v4 scanner enumerates source files through the git index when
# a .git is present and falls back to a traversal that misses part of the
# renderer's utility classes otherwise. A released tarball has no .git, so
# feed the scanner one.
export OPENCODE_CHANNEL=prod
git init -q
git add -A

cd packages/desktop
# build.ts copies the prod icons and the AppStream metainfo into resources/,
# stages the CLI from ../cli/dist (a symlink, see Patch5) and runs
# electron-vite itself; running it again would just repeat the work.
bun ./script/build.ts
cd ../..

%install
# CLI.
%__install -Dpm 0755 packages/cli/dist/%cli_dist/bin/%name \
    %buildroot%_bindir/%name

# Shared data.
%__mkdir_p %buildroot%_datadir/%name
%__cp -a tree-sitter %buildroot%_datadir/%name/tree-sitter

# Desktop client: assemble the app directory electron-builder would produce,
# without electron-builder. out/, the runtime icons, the staged CLI symlink
# (Patch5) and the one dependency the main bundle leaves externalised are
# needed at run time; everything else is bundled into out/.
appdir=%buildroot%_libexecdir/%name-desktop
%__mkdir_p "$appdir/resources" "$appdir/node_modules/@lydell"
%__cp -a packages/desktop/out "$appdir/out"
%__cp -a packages/desktop/resources/icons "$appdir/resources/icons"
# The CLI symlink and its version sidecar, both written by the build.
%__cp -a packages/desktop/resources/opencode-cli \
    packages/desktop/resources/opencode-cli.version "$appdir/resources/"
# The icons directory carries sets for every platform (android/, ios/,
# Windows store tiles); nothing on Linux reaches them.
%__rm -rf "$appdir/resources/icons/android" "$appdir/resources/icons/ios"
%__rm -f "$appdir"/resources/icons/Square*.png "$appdir/resources/icons/StoreLogo.png"
%__cp -aL "packages/desktop/node_modules/@lydell/node-pty-linux-%node_arch" \
    "$appdir/node_modules/@lydell/"
# electron-builder would generate this from its config. The desktopName key
# is what Electron uses as the Wayland app_id (with the .desktop suffix
# stripped).
cat > "$appdir/package.json" <<EOF
{
  "name": "%name-desktop",
  "productName": "OpenCode",
  "version": "%version",
  "type": "module",
  "main": "./out/main/index.js",
  "desktopName": "%name-desktop.desktop"
}
EOF
# npm trees occasionally carry world-writable bits. GNU chmod -R skips
# symlinks, so the staged CLI symlink stays untouched.
%__chmod -R go-w "$appdir"

# Launcher. ELECTRON_FORCE_IS_PACKAGED: a system electron started with an app
# directory argument treats it as an unpackaged "default app", and the app
# would then pick its dev appId and user-data paths.
#
# --ozone-platform-hint=auto: this electron build ignores the
# ELECTRON_OZONE_PLATFORM_HINT environment variable and always initializes
# X11, which on a Wayland session without a reachable X server means the app
# exits before creating a window. The hint selects the platform from the
# session type instead - native Wayland under Wayland, X11 under X11 - and
# an explicit --ozone-platform on the command line still wins over it.
%__install -Dpm 0755 /dev/stdin %buildroot%_bindir/%name-desktop <<EOF
#!/bin/sh
ELECTRON_FORCE_IS_PACKAGED=1 exec %_bindir/electron --ozone-platform-hint=auto %_libexecdir/%name-desktop "\$@"
EOF

# Desktop entry. StartupWMClass=OpenCode matches the X11 WM_CLASS that
# electron derives from app.name; on Wayland the app_id comes from the
# desktopName key in the package.json above.
%__install -Dpm 0644 /dev/stdin \
    %buildroot%_datadir/applications/%name-desktop.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=OpenCode
GenericName=AI Coding Agent
Comment=Desktop client for the opencode AI coding agent
Exec=opencode-desktop %%U
Icon=opencode-desktop
Terminal=false
Categories=Development;IDE;
MimeType=x-scheme-handler/opencode;
StartupWMClass=OpenCode
EOF

# Icons for menus and app grids.
for pair in 32x32.png:32x32 64x64.png:64x64 128x128.png:128x128 '128x128@2x.png:256x256' icon.png:512x512; do
    %__install -Dpm 0644 "packages/desktop/resources/icons/${pair%%:*}" \
        "%buildroot%_datadir/icons/hicolor/${pair##*:}/apps/%name-desktop.png"
done

# AppStream metadata, generated by prebuild.ts for the prod appId.
%__install -Dpm 0644 packages/desktop/resources/ai.opencode.desktop.metainfo.xml \
    %buildroot%_metainfodir/ai.opencode.desktop.metainfo.xml

%check
%buildroot%_bindir/%name --version
test "$(%buildroot%_bindir/%name --version)" = "%name v%version"
test -d %buildroot%_datadir/%name/tree-sitter

test -x %buildroot%_bindir/%name-desktop
test -f %buildroot%_libexecdir/%name-desktop/out/main/index.js
test -f %buildroot%_libexecdir/%name-desktop/out/preload/index.cjs
test -f %buildroot%_libexecdir/%name-desktop/out/renderer/index.html
# The staged CLI is a symlink into the package file tree (Patch5): it dangles
# in the build root and must still be a symlink pointing at the CLI.
test -L %buildroot%_libexecdir/%name-desktop/resources/opencode-cli
test "$(readlink %buildroot%_libexecdir/%name-desktop/resources/opencode-cli)" = "/usr/bin/%name"
test -f %buildroot%_libexecdir/%name-desktop/resources/opencode-cli.version
test -f %buildroot%_libexecdir/%name-desktop/node_modules/@lydell/node-pty-linux-%node_arch/prebuilds/linux-%node_arch/pty.node
grep -q '"desktopName": "%name-desktop.desktop"' \
    %buildroot%_libexecdir/%name-desktop/package.json

# The main chunk must not reference any package outside electron and the one
# externalised dependency: a stray reference would fail at run time, where no
# node_modules tree exists next to the app. Bundled code no longer carries
# import statements, so every bare-package specifier left in the output - a
# static import, a dynamic import() or a require through the CommonJS shim -
# is an external reference. Relative chunk paths and node: builtins are fine.
if grep -oE '(require\(|import\(|from )"[^"]+"' \
        %buildroot%_libexecdir/%name-desktop/out/main/index.js \
        | sed -E 's/^.*"(.*)"$/\1/' \
        | grep -vE '^(\.|electron($|/)|node:|@lydell/node-pty)' ; then
    echo "unexpected external package reference in the main chunk" >&2
    exit 1
fi

%files
%doc LICENSE README*.md CONTRIBUTING.md SECURITY.md
%_bindir/%name
%dir %_datadir/%name
%_datadir/%name/tree-sitter

%files desktop
%_bindir/%name-desktop
%_libexecdir/%name-desktop
%_datadir/applications/%name-desktop.desktop
%_datadir/icons/hicolor/*/apps/%name-desktop.png
%_metainfodir/ai.opencode.desktop.metainfo.xml

