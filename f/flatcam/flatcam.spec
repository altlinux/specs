#Unpackaged files in buildroot should terminate build
%define _unpackaged_files_terminate_build 1

Name: flatcam
Version: 8.995
Release: alt2

Summary: 2D Computer-Aided PCB Manufacturing

Group: Engineering
License: MIT

VCS: https://bitbucket.org/marius_stanciu/flatcam_beta/branches
URL: https://bitbucket.org/marius_stanciu/flatcam_beta/branches

Source: %name-%version.tar
Patch: %name-%version-%release.patch

BuildArch: noarch

AutoProv: nopython3

Buildrequires(pre): rpm-macros-python3
Buildrequires: rpm-build-python3

Requires: libGLU
%add_python3_path %_datadir/%name

%description
FlatCAM is a program for preparing CNC jobs for making PCBs on
a CNC router. Among other things, it can take a Gerber file
generated by your favorite PCB CAD program, and create G-Code
for Isolation routing.

%prep
%setup
%patch -p1

%install
%makeinstall_std
# requires svgtrace, which requires the problematic python3-module-playwright (it is built 
# with an excessive number of dependencies: -dev, node-playwright and others)
rm -f %buildroot%_datadir/%name/appPlugins/ToolImage.py

%files
%doc README.md LICENSE
%_datadir/%name
%_bindir/%name
%_desktopdir/%name.desktop

