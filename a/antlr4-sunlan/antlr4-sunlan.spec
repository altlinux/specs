%description
The Daniel Sun fork of ANTLR 4, including its nullability
annotations, Java runtime, parser generator, and Maven plugins.

%package annotations
Summary: Runtime annotations for the Sunlan ANTLR fork
Group: Development/Java

%description annotations
Nullability annotations and their annotation processor from the Sunlan
Laboratories ANTLR 4 fork.

%package runtime
Summary: Java runtime for the Sunlan ANTLR fork
Group: Development/Java

%description runtime
The Java runtime library used by parsers generated by the Sunlan
Laboratories ANTLR 4 fork.

%package maven-plugin
Summary: Maven plugin for the Sunlan ANTLR fork
Group: Development/Java

%description maven-plugin
The Maven plugin for generating parsers with the Daniel Sun
ANTLR 4 fork.

%package testgen-maven-plugin
Summary: Maven test generation plugin for the Sunlan ANTLR fork
Group: Development/Java

%description testgen-maven-plugin
The Maven plugin used by the ANTLR fork to generate runtime test sources.

%package testsuite
Summary: Runtime testsuite library for the Sunlan ANTLR fork
Group: Development/Java

%description testsuite
Shared Java test support from the Daniel Sun ANTLR 4 project.

%package perf-testsuite
Summary: Performance testsuite for the Sunlan ANTLR fork
Group: Development/Java

%description perf-testsuite
Performance benchmark support from the Daniel Sun ANTLR 4
project.

%javadoc_package

%prep
%setup
# Skip only the JDK-source benchmark and the Maven-plugin module test harness;
# its Takari lifecycle testProperties extension is absent offline. The package
# is validated later with an installed Maven consumer.
%patch0 -p1
%pom_remove_parent
# Set startup options only for Surefire; parser subprocess stderr must stay clean.
%pom_xpath_inject 'pom:project/pom:build/pom:plugins/pom:plugin[pom:artifactId="maven-surefire-plugin"]/pom:configuration' \
    '<argLine>--add-opens=java.base/java.util=ALL-UNNAMED -Djava.security.manager=allow</argLine>' tool
# This module's Takari harness is already skipped; do not compile its tests.
%pom_remove_dep io.takari.maven.plugins:takari-plugin-testing antlr4-maven-plugin
%pom_xpath_inject pom:project '<properties><maven.test.skip>true</maven.test.skip></properties>' antlr4-maven-plugin
%pom_remove_plugin org.sonatype.plugins:nexus-staging-maven-plugin
%pom_remove_plugin :maven-gpg-plugin
# Generate XPathLexer with our own tool after the in-SRPM bootstrap pass.
%pom_remove_plugin com.tunnelvisionlabs:antlr4-maven-plugin runtime/Java
# Use the system HPPC library, without embedding or relocating its classes.
%pom_remove_plugin :maven-shade-plugin runtime/Java
# The upstream verify goal checks embedded HPPC, which ALT does not ship.
%pom_remove_plugin :maven-antrun-plugin runtime/Java
%pom_xpath_set "pom:build//pom:instructions/pom:Import-Package" \
    "*" runtime/Java
%mvn_package :antlr4-annotations annotations
%mvn_package :antlr4-runtime runtime
%mvn_package :antlr4-maven-plugin maven-plugin
%mvn_package :antlr4-testgen-maven-plugin testgen-maven-plugin
%mvn_package :runtime-testsuite testsuite
%mvn_package :antlr4-perf-testsuite perf-testsuite

%mvn_file :antlr4-annotations antlr4-sunlan/annotations
%mvn_file :antlr4-runtime antlr4-sunlan/runtime
%mvn_file :antlr4 antlr4-sunlan/tool
%mvn_file :antlr4-maven-plugin antlr4-sunlan/maven-plugin
%mvn_file :antlr4-testgen-maven-plugin antlr4-sunlan/testgen-maven-plugin
%mvn_file :runtime-testsuite antlr4-sunlan/runtime-testsuite
%mvn_file :antlr4-perf-testsuite antlr4-sunlan/perf-testsuite

%build
sh %SOURCE1
%mvn_build -- -DargLine="--add-opens=java.base/java.util=ALL-UNNAMED"

%install
%mvn_install

%files -f .mfiles
%doc LICENSE.txt README.md

%files annotations -f .mfiles-annotations

%files runtime -f .mfiles-runtime

%files maven-plugin -f .mfiles-maven-plugin

%files testgen-maven-plugin -f .mfiles-testgen-maven-plugin

%files testsuite -f .mfiles-testsuite

%files perf-testsuite -f .mfiles-perf-testsuite

