%define _unpackaged_files_terminate_build 1

%define maven_version %version.v92788b_1f0a_21

Name: annotation-indexer
Version: 1.213
Release: alt1

Summary: Index annotated Java elements during compilation
License: MIT
Group: Development/Java
URL: https://github.com/jenkinsci/lib-annotation-indexer
VCS: https://github.com/jenkinsci/lib-annotation-indexer.git

Source: %name-%version.tar

BuildArch: noarch
BuildRequires(pre): rpm-macros-java
BuildRequires: maven-local
BuildRequires: java-21-openjdk-devel
BuildRequires: metainf-services
BuildRequires: kohsuke-pom
BuildRequires: mvn(org.apache.maven.plugins:maven-compiler-plugin)

%description
Creates indexes of annotated classes, methods, fields, constructors and
packages, and provides a runtime API to query these indexes. Includes the
annotation processor and service registration generated by MetaInfServices.

%package javadoc
Summary: API documentation for %name
Group: Development/Java

%description javadoc
API documentation for Annotation Indexer.

%prep
%setup
rm .mvn/extensions.xml .mvn/maven.config
# Replace Jenkins release automation with the ordinary system lifecycle.
%pom_remove_parent
%pom_xpath_inject pom:project '<groupId>org.jenkins-ci</groupId>'
%pom_xpath_set pom:version %maven_version
# These three files form the Elementary-dependent compiler test fixture.
rm src/test/java/org/jvnet/hudson/annotation_indexer/AnnotationProcessorImplTest.java
rm src/test/java/org/jvnet/hudson/annotation_indexer/Utils.java
rm src/test/java/org/jvnet/hudson/annotation_indexer/package-info.java
%pom_remove_dep com.karuslabs:elementary
%pom_remove_dep org.junit.jupiter:junit-jupiter
%pom_remove_dep org.junit.vintage:junit-vintage-engine

%build
%mvn_build -- -Dmaven.compiler.release=17 -Dmaven.compiler.proc=full \
    -Dproject.build.sourceEncoding=UTF-8

%install
%mvn_install

%files -f .mfiles

%files javadoc -f .mfiles-javadoc

%changelog
* Mon Nov 16 2026 Ivan Khanas <xeno@altlinux.org> 1.213-alt1
- Initial build for ALT.
