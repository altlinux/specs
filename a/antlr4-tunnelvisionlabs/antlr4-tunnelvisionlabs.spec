%javadoc_package

%prep
%setup
# Skip only the JDK-source benchmark and the Maven-plugin module test harness;
# its Takari lifecycle testProperties extension is absent offline. The package
# is validated later with an installed Maven consumer.
%patch0 -p1
%pom_remove_parent
# Generate XPathLexer with our own tool after the in-SRPM bootstrap pass.
%pom_remove_plugin com.tunnelvisionlabs:antlr4-maven-plugin runtime/Java
# The upstream project targets Java 6, which the system JDK no longer supports.
%pom_xpath_set \
    'pom:build/pom:plugins/pom:plugin[pom:artifactId="maven-compiler-plugin"]/'\
pom:configuration/pom:source \
    8
%pom_xpath_set \
    'pom:build/pom:plugins/pom:plugin[pom:artifactId="maven-compiler-plugin"]/'\
pom:configuration/pom:target \
    8
%mvn_package :antlr4-annotations annotations
%mvn_package :antlr4-runtime runtime
%mvn_package :antlr4-maven-plugin maven-plugin
%mvn_package :antlr4-testgen-maven-plugin testgen-maven-plugin
%mvn_package :runtime-testsuite testsuite
%mvn_package :antlr4-perf-testsuite perf-testsuite

%mvn_file :antlr4-annotations antlr4-tunnelvisionlabs/annotations
%mvn_file :antlr4-runtime antlr4-tunnelvisionlabs/runtime
%mvn_file :antlr4 antlr4-tunnelvisionlabs/tool
%mvn_file :antlr4-maven-plugin antlr4-tunnelvisionlabs/maven-plugin
%mvn_file :antlr4-testgen-maven-plugin \
    antlr4-tunnelvisionlabs/testgen-maven-plugin
%mvn_file :runtime-testsuite antlr4-tunnelvisionlabs/runtime-testsuite
%mvn_file :antlr4-perf-testsuite antlr4-tunnelvisionlabs/perf-testsuite

%build
# Break the proven runtime -> generator -> tool -> runtime cycle in-SRPM.
# The system generator's output is used only to compile the first-stage tool.
# Its XPath lexer must not execute; the fork tool replaces it before final
# tests.
mkdir .bootstrap
xpath_dir=runtime/Java/src/org/antlr/v4/runtime/tree/xpath
antlr4 -package org.antlr.v4.runtime.tree.xpath \
    -Xexact-output-dir -o "$xpath_dir" "$xpath_dir/XPathLexer.g4"
sed -i \
    -e /RuntimeMetaData.checkVersion/d \
    -e '/import org.antlr.v4.runtime.RuntimeMetaData;/d' \
    -e 's/new LexerATNSimulator(this,[[:space:]]*_ATN,[[:space:]]*_d'\
'ecisionToDFA,[[:space:]]*_sharedContextCache)/new LexerATNSi'\
'mulator(this, _ATN)/' \
    "$xpath_dir/XPathLexer.java"
cp "$xpath_dir/XPathLexer.java" .bootstrap/
xmvn --batch-mode --offline -Dmaven.test.skip=true -pl tool -am package
antlr_bootstrap_cp="$PWD/tool/target/classes"
antlr_bootstrap_cp="$antlr_bootstrap_cp:$PWD/runtime/Java/target/classes"
antlr_annotations="$PWD/runtime/JavaAnnotations/target/classes"
antlr_bootstrap_cp="$antlr_bootstrap_cp:$antlr_annotations"
antlr_bootstrap_cp="$antlr_bootstrap_cp:$(build-classpath \
    antlr3-runtime stringtemplate4/ST4 treelayout/org.abego.treelayout.core)"
java -cp "$antlr_bootstrap_cp" org.antlr.v4.Tool \
    -package org.antlr.v4.runtime.tree.xpath -Xexact-output-dir \
    -o "$xpath_dir" "$xpath_dir/XPathLexer.g4"
# Recompile the complete runtime and tool; no bootstrap classes enter RPMs.
rm -rf runtime/JavaAnnotations/target runtime/Java/target \
    runtime-testsuite/target antlr4-testgen-maven-plugin/target tool/target
%mvn_build

%install
%mvn_install

%files -f .mfiles
%doc LICENSE.txt

%files annotations -f .mfiles-annotations

%files runtime -f .mfiles-runtime

%files maven-plugin -f .mfiles-maven-plugin

%files testgen-maven-plugin -f .mfiles-testgen-maven-plugin

%files testsuite -f .mfiles-testsuite

%files perf-testsuite -f .mfiles-perf-testsuite

